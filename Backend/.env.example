# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/complaintDB
PORT=5000

# Secret used to sign admin login tokens (use a long random string)
JWT_SECRET=change-me

# Frontend URL(s), comma separated. Used for CORS and links in emails.
CLIENT_URL=http://localhost:5173

# Optional: AI classification (falls back to keyword rules when missing)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Email notifications. Gmail SMTP (use an App Password) is tried first and can email anyone.
EMAIL_USER=
EMAIL_PASS=
# Fallback: Resend (without a verified domain it only delivers to your own Resend account email)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
